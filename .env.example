##############################################################################
# CareerPilot360 — environment configuration
#
# Copy to `.env.local` for local development:   cp .env.example .env.local
# Never commit a filled-in copy. `.env` and `.env*.local` are gitignored.
#
# Only DATABASE_URL and AUTH_SECRET are required to run the app. Everything
# else degrades to a clearly-labelled "not configured" state in the UI rather
# than silently faking data.
##############################################################################

# ─── Core (required) ────────────────────────────────────────────────────────

# Postgres. In production, provision from the Vercel Marketplace (Neon,
# Supabase or Prisma Postgres all work) and Vercel injects this for you.
# Locally, any Postgres 14+ instance:
#   createdb careerpilot360
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerpilot360"

# Session signing secret. Generate one:
#   openssl rand -base64 32
AUTH_SECRET=""

# Public base URL. Used in verification/reset links and OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Only set AUTH_URL if you are behind a proxy that rewrites the host.
# AUTH_URL="https://your-app.vercel.app"


# ─── Provider-key encryption (required to store AI keys) ────────────────────

# AES-256-GCM key. Must decode to exactly 32 bytes. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ROTATION: put the NEW key first, keep the old one second, comma-separated.
# Both are tried on decrypt; only the first is used to encrypt. Once every row
# has been re-encrypted you can drop the old key.
#   ENCRYPTION_KEY="newKeyBase64,oldKeyBase64"
ENCRYPTION_KEY=""


# ─── LinkedIn sign-in (optional) ────────────────────────────────────────────
#
# Official OpenID Connect sign-in only. CareerPilot360 requests just
# `openid profile email` and never stores a LinkedIn access token, because it
# never acts on your LinkedIn account. It will never ask for a portal password.
#
# Setup: linkedin.com/developers → create an app → Products → enable
# "Sign In with LinkedIn using OpenID Connect" → add the redirect URL:
#   http://localhost:3000/api/auth/callback/linkedin
#   https://<your-domain>/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""


# ─── Document storage (optional locally, required in production) ────────────
#
# Vercel Blob. Objects are written with `access: 'private'` and streamed back
# only through authenticated routes.
# Setup: Vercel dashboard → Storage → Create Blob store → copy the token.
BLOB_READ_WRITE_TOKEN=""

# auto  → Blob when BLOB_READ_WRITE_TOKEN is set, otherwise local filesystem
# blob  → force Vercel Blob (fails fast if the token is missing)
# local → force the filesystem driver (development only)
STORAGE_DRIVER="auto"
LOCAL_STORAGE_DIR=".storage"


# ─── Background processing (required for scheduling) ────────────────────────

# Shared secret for the Vercel Cron routes. Generate one:
#   openssl rand -hex 32
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""


# ─── Email (optional) ───────────────────────────────────────────────────────
#
# console → messages are written to the server log; nothing is delivered.
#           This is the default and is what CI uses.
# resend  → real delivery through Resend's HTTP API.
#
# Outreach email additionally requires a per-message confirmation from the
# user, and is subject to suppression lists and daily caps regardless of
# driver. Sending on behalf of the user via Gmail/Microsoft OAuth is the
# preferred production path — see docs/adapters.md.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
# Must be a domain you have verified with the provider.
EMAIL_FROM="CareerPilot360 <noreply@example.com>"


# ─── External job search (optional) ─────────────────────────────────────────
#
# none   → only the always-available compliant sources: public Greenhouse,
#          Lever and Ashby boards, pasted job URLs, and manual entry.
# adzuna → adds the Adzuna aggregator API (free developer tier).
#          Register at developer.adzuna.com. Chosen because its terms permit
#          programmatic search; see docs/adapters.md for why it is isolated
#          behind an adapter.
SEARCH_PROVIDER="none"
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""


# ─── Application-level AI fallback (optional) ───────────────────────────────
#
# Users normally bring their own key (Settings → AI providers), which is the
# intended model. These variables provide an optional shared fallback so the
# app is usable before a user configures anything.
#
# APP_AI_PROVIDER: groq | google | openrouter | mistral | openai | anthropic |
#                  azure-openai | openai-compatible
APP_AI_PROVIDER=""
APP_AI_API_KEY=""
APP_AI_MODEL=""
# Only for openai-compatible / azure-openai deployments.
APP_AI_BASE_URL=""


# ─── Development escape hatches ─────────────────────────────────────────────

# Leave unset. When set to "1", relaxes the SSRF host checks so you can import
# a job from a local fixture server. Never enable in production.
# ALLOW_INSECURE_URL_FETCH=""
