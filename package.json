{
  "name": "careerpilot360",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "CareerPilot360 - multi-tenant AI job application assistant (compliant, human-in-the-loop).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@hookform/resolvers": "5.9.1",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "docx": "9.7.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.33.0",
    "mammoth": "1.12.1",
    "motion": "13.1.1",
    "nanoid": "6.0.1",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "unpdf": "1.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
